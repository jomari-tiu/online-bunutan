# Copy to .env and change these.

# Port the server listens on.
PORT=8787

# Which website may call the API (your frontend's address). Comma-separated, or * for any.
CORS_ORIGIN=*

# Postgres connection string (e.g. from Neon). When set, data is saved there.
# When empty, data is saved to a local JSON file (DATA_FILE) instead.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local JSON file used when DATABASE_URL is not set.
# DATA_FILE=./data/db.json
