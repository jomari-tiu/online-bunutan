# Copy to .env and change these.

# Password for the organizer page (required in production).
ADMIN_KEY=change-me-to-something-long

# Port the server listens on.
PORT=8787

# Which website may call the API (your frontend's address). Comma-separated, or * for any.
CORS_ORIGIN=*

# Where the JSON data is saved. Must be on a disk that survives restarts.
# DATA_FILE=./data/db.json
